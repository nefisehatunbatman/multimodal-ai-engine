# Main PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ai_engine

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL_PRIMARY=openai/gpt-4o-mini
OPENROUTER_MODEL_FALLBACK=google/gemini-1.5-flash
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_HOST=localhost
QDRANT_API_KEY=
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=ai_engine_docs
QDRANT_USE_TLS=false

# WeKnora services
WEKNORA_VERSION=latest
WEKNORA_APP_HOST=localhost
WEKNORA_APP_PORT=8080
WEKNORA_UI_PORT=3080
WEKNORA_API_KEY=your-weknora-api-key
WEKNORA_KB_ID=your-weknora-knowledge-base-id
WEKNORA_DB_USER=weknora
WEKNORA_DB_PASSWORD=weknora
WEKNORA_DB_NAME=weknora
WEKNORA_QDRANT_PORT=6334
WEKNORA_QDRANT_COLLECTION=weknora_embeddings
WEKNORA_REDIS_PASSWORD=weknora_redis_dev_secret
WEKNORA_JWT_SECRET=change_me_32_chars_minimum_dev
WEKNORA_TENANT_AES_KEY=change_me_32_chars_minimum_dev
WEKNORA_SYSTEM_AES_KEY=change_me_32_chars_minimum_dev
WEKNORA_GIN_MODE=release
WEKNORA_DISABLE_REGISTRATION=false

# MQTT / EMQX
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=public

# App security
JWT_SECRET=change_me_32_chars_minimum_dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Runtime
OLLAMA_BASE_URL=http://host.docker.internal:11434
REDIS_DB=0
REDIS_ADDR=WeKnora-redis:6379
TENANT_AES_KEY=change_me_32_chars_minimum_dev
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
GIN_MODE=release
LOG_LEVEL=info
MAX_FILE_SIZE_MB=50
MAX_HISTORY_MESSAGES=6
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
DOCREADER_TRANSPORT=grpc
